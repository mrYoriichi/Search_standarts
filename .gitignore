# Виртуальное окружение Python — у каждого разработчика своё, в git не нужно
.venv/
venv/
env/

# Кэш Python — создаётся автоматически, мусор
__pycache__/
*.pyc
*.pyo

# Данные проекта — PDF и результаты обработки, не код
data/

# Секреты — API-ключи, пароли. ЗАЩИТА ОТ СЛУЧАЙНОЙ УТЕЧКИ
.env
*.key
secrets/

# Служебные файлы macOS — мусор, который маки создают в каждой папке
.DS_Store

# Служебные файлы VSCode (личные настройки редактора)
.vscode/

# Логи
*.log

# Локальная БД приложения (создаётся на машине пользователя)
app.db
*.db-journal
*.db-wal
*.db-shm

# Артефакты сборки PyInstaller (блок E)
/build/
/dist/

# Собранный установщик Inno Setup (большой, в git не нужен)
/installer/

# Собранный фронтенд — генерируется `npm run build`, в git не нужен
frontend/dist/

# Модели docling — скачиваются `download_models.py`, большие, в git не нужны
docling_models/