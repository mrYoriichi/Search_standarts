# Python virtual environment — each developer has their own, not for git
.venv/
venv/
env/

# Python cache — created automatically, junk
__pycache__/
*.pyc
*.pyo

# Project data — PDFs and processing results, not code
data/

# Secrets — API keys, passwords. GUARDS AGAINST ACCIDENTAL LEAKS
.env
*.key
secrets/

# macOS service files — junk Macs create in every folder
.DS_Store

# VSCode service files (personal editor settings)
.vscode/

# Logs
*.log

# Local app database (created on the user's machine)
app.db
*.db-journal
*.db-wal
*.db-shm

# PyInstaller build artifacts (block E)
/build/
/dist/

# Built Inno Setup installer (large, not for git)
/installer/

# Built frontend — generated by `npm run build`, not for git
frontend/dist/

# Docling models — downloaded by `download_models.py`, large, not for git
docling_models/